# kan.bn Environment Configuration
# Docs: https://docs.kan.bn/guides/self-hosting/introduction
#
# Copy this file to .env, then fill in every value under "Required" before
# running `docker compose up -d`.
#
# Optional sections are commented out by default. Uncomment a variable and
# set its value to enable the corresponding feature. Leave a variable
# commented out entirely — do not set it to an empty string — to keep
# the feature disabled; the app's environment validation rejects empty
# strings for URL and credential fields.

# ── Required ────────────────────────────────────────────────────────────────

# Public URL of this instance (no trailing slash).
# Use the address users will type in their browser.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret key used by Better Auth to sign sessions.
# Must be at least 32 random characters. Changing this value invalidates
# all active sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL connection string.
# The hostname must be "postgres" — the Compose service name — because
# Docker routes between containers using service names, not container names.
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_URL=postgresql://kan:your_password@postgres:5432/kan_db

# PostgreSQL credentials — must match the values embedded in POSTGRES_URL above.
POSTGRES_USER=kan
POSTGRES_DB=kan_db
POSTGRES_PASSWORD=

# ── Optional: host port mapping ─────────────────────────────────────────────

# Host port the web app is exposed on (default: 3000).
# WEB_PORT=3000

# ── Optional: authentication ────────────────────────────────────────────────

# Uncomment and set to "true" to prevent new user registrations.
# NEXT_PUBLIC_DISABLE_SIGN_UP=false

# ── Optional: email / SMTP ──────────────────────────────────────────────────
# All six variables must be set together to enable transactional email
# (password reset, invitations). Leave this section commented out to
# disable email features entirely.

# EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# ── Optional: S3-compatible file storage ────────────────────────────────────
# Required to enable avatar and attachment uploads.
# Leave this section commented out to disable file uploads.

# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_STORAGE_URL=https://cdn.example.com
# NEXT_PUBLIC_STORAGE_DOMAIN=cdn.example.com

# ── Optional: integrations ──────────────────────────────────────────────────

# Trello board import
# TRELLO_APP_API_KEY=
# TRELLO_APP_SECRET=

# ── Optional: data storage path ─────────────────────────────────────────────

# Absolute host path where PostgreSQL data files are stored.
# Defaults to a "kan_data" directory next to the Compose file when unset.
DOCKER_DATA_PATH=/home/docker/kanbn
