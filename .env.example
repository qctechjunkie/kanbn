# kan.bn Environment Configuration
# Docs: https://docs.kan.bn/guides/self-hosting/introduction
#
# Copy this file to .env, then fill in every required value before
# running `docker compose up -d`.
#
# Required variables must be set; optional variables can be left blank
# to disable the associated feature.

# ── Required ────────────────────────────────────────────────────────────────

# Public URL of this kan.bn instance (no trailing slash).
# Use the address users will type in their browser.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret key used by Better Auth to sign sessions.
# Must be at least 32 random characters. Changing this invalidates all
# existing sessions.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL connection string.
# The hostname must match the Compose service name ("postgres"), not
# the container name, because Docker routes by service name on the
# internal network.
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_URL=postgresql://kan:your_password@postgres:5432/kan_db

# PostgreSQL credentials — must match the values embedded in POSTGRES_URL.
POSTGRES_USER=kan
POSTGRES_DB=kan_db
POSTGRES_PASSWORD=

# ── Optional: host port mapping ─────────────────────────────────────────────

# Host port the web app listens on (default: 3000).
WEB_PORT=3000

# ── Optional: authentication ────────────────────────────────────────────────

# Set to "true" to prevent new user registrations (default: false).
NEXT_PUBLIC_DISABLE_SIGN_UP=false

# ── Optional: email / SMTP ──────────────────────────────────────────────────
# Leave blank to disable transactional email (password reset, invites, etc.).

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Set to "true" to require TLS; "false" to use STARTTLS or plain text.
SMTP_SECURE=

# ── Optional: S3-compatible file storage ────────────────────────────────────
# Leave blank to disable avatar and attachment uploads.

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_STORAGE_DOMAIN=

# ── Optional: integrations ──────────────────────────────────────────────────

# Trello import
TRELLO_APP_API_KEY=
TRELLO_APP_SECRET=

# ── Optional: data storage path ─────────────────────────────────────────────

# Absolute host path where persistent data (PostgreSQL files) is stored.
# Defaults to a "kan_data" directory next to the Compose file when unset.
DOCKER_DATA_PATH=/home/docker/kanbn
